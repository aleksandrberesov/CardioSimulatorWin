<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline packer that turns a plain content ZIP (Pathologies.zip / Courses.zip) into an
    encrypted *.pak for distribution. It references CardioSimulator.Core so it uses the exact same
    ContentCrypto as the runtime: the pack format can never drift from what the app can decrypt.
    See README_BUILD.md ("Protected content packs") for the exact invocation.

    Intentionally NOT part of CardioSimulatorWin.sln: it is a build/authoring tool, not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ContentPacker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CardioSimulator.Core\CardioSimulator.Core.csproj" />
  </ItemGroup>

</Project>
