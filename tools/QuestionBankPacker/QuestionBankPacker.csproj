<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline tool: turns a question-bank interchange JSON (the Test Constructor's export format)
       into the encrypted Assets/QuestionBank.pak the app ships. Deliberately NOT in
       CardioSimulatorWin.sln and not built by tools/build.ps1 — it is run by hand when the customer
       delivers a new bank, exactly like the pathology/course packers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuestionBankPacker</AssemblyName>
    <RootNamespace>CardioSimulator.Tools.QuestionBankPacker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CardioSimulator.Core\CardioSimulator.Core.csproj" />
  </ItemGroup>

</Project>
