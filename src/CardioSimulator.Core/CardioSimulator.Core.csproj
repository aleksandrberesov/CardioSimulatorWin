<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release;Limited</Configurations>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CardioSimulator.Core</RootNamespace>
    <AssemblyName>CardioSimulator.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical ECG acronym taxonomy (the join spine wiring rhythms/lectures/tests/results).
         Generated by tools/taxonomy-build/build_taxonomy.py; embedded so it ships in the DLL and
         is available in every edition + in unit tests without any file/asset resolution. -->
    <EmbeddedResource Include="Domain\Taxonomy.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CSP2 chunk framing is internal, but it is crypto: its boundary/tamper behaviour must be
         testable directly rather than only through the public archive API. -->
    <InternalsVisibleTo Include="CardioSimulator.Core.Tests" />
  </ItemGroup>

</Project>
