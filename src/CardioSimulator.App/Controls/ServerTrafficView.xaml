<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CardioSimulator.App.Controls.ServerTrafficView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CardioSimulator.App.Controls">
    <!-- Administrator "Server message log": the live TCP conversation with the monitor server. Every brush is a
         {ThemeResource}, so re-setting RequestedTheme on this root (ServerTrafficWindow follows AppTheme.Changed)
         recolours the whole window in place. All label text is assigned in code (ApplyStrings), never rebuilt. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Star row bounds the ListView's height so it virtualizes. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- Header: connection status · target address · connect/disconnect -->
        <Border Grid.Row="0" Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8,12,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                    <ProgressRing x:Name="ConnectingRing" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                  IsActive="False" Visibility="Collapsed" />
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <!-- An Error state carries a socket message of unbounded length: ellipsize (full text in the tooltip). -->
                <TextBlock x:Name="StatusText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock x:Name="TargetText" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <Button x:Name="ConnectButton" Grid.Column="3" MinWidth="110" CornerRadius="6"
                        VerticalAlignment="Center" Click="OnConnectClick" />
            </Grid>
        </Border>

        <!-- Toolbar: filter · search · auto-scroll · pause · copy list · clear. Only fixed-size controls live here: the
             variable-length feedback (paused count, "Copied") sits in the footer beside the stats, so the row never grows
             past the window's 860-DIP minimum in any language (Russian ~815 DIP). The search cell is the only elastic one,
             so on a narrow window the search box gives way first instead of the action buttons being pushed off-screen. -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterBox" Grid.Column="0" MinWidth="150" CornerRadius="6"
                      VerticalAlignment="Center" SelectionChanged="OnFilterChanged">
                <ComboBoxItem x:Name="FilterAllItem" />
                <ComboBoxItem x:Name="FilterSentItem" />
                <ComboBoxItem x:Name="FilterReceivedItem" />
                <ComboBoxItem x:Name="FilterEventsItem" />
                <ComboBoxItem x:Name="FilterErrorsItem" />
            </ComboBox>
            <!-- A stretched box with only a MaxWidth would be centred in a wide cell; the capped star column keeps it
                 left-aligned and leaves the spare width between it and the toggles. -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" HorizontalAlignment="Stretch" MinWidth="160" MaxWidth="360"
                         CornerRadius="6" VerticalAlignment="Center"
                         IsSpellCheckEnabled="False" TextChanged="OnSearchChanged" />
            </Grid>
            <CheckBox x:Name="AutoScrollCheck" Grid.Column="2" MinWidth="0" IsChecked="True"
                      VerticalAlignment="Center" Click="OnAutoScrollClick" />
            <CheckBox x:Name="PauseCheck" Grid.Column="3" MinWidth="0"
                      VerticalAlignment="Center" Click="OnPauseClick" />
            <Button x:Name="CopyAllButton" Grid.Column="4" CornerRadius="6" VerticalAlignment="Center"
                    Click="OnCopyAllClick" />
            <Button x:Name="ClearButton" Grid.Column="5" CornerRadius="6" VerticalAlignment="Center"
                    Click="OnClearClick" />
        </Grid>

        <!-- Message list card: column header + virtualized list (+ empty-state text over it) -->
        <Border Grid.Row="2" Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column widths match the item template below; the side padding matches the item container's. -->
                <Grid x:Name="ColumnHeaderGrid" Grid.Row="0" Padding="12,6,12,6" ColumnSpacing="10"
                      BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ColTimeText" Grid.Column="0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ColDirectionText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ColTypeText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ColMessageText" Grid.Column="3" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ColSizeText" Grid.Column="4" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </Grid>

                <ListView x:Name="LogList" Grid.Row="1" SelectionMode="Single"
                          SelectionChanged="OnListSelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="28" />
                            <Setter Property="Padding" Value="12,0,12,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ServerTrafficRow">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TimeText}" FontFamily="Consolas" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DirectionGlyph}" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="{x:Bind AccentBrush}"
                                           ToolTipService.ToolTip="{x:Bind DirectionTooltip}" />
                                <!-- Localized event names can outgrow the fixed 140 cell: full text in the tooltip. -->
                                <TextBlock Grid.Column="2" Text="{x:Bind TypeText}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{x:Bind AccentBrush}"
                                           ToolTipService.ToolTip="{x:Bind TypeText}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Summary}" FontSize="12" MaxLines="1"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           ToolTipService.ToolTip="{x:Bind Summary}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SizeText}" FontFamily="Consolas" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="24" MaxWidth="480"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Footer: running totals since the log was created / last cleared, then the toolbar's variable-length feedback
             (paused count, "Copied") — kept out of the toolbar so it can't push the action buttons off a narrow window. -->
        <Grid Grid.Row="3" Margin="4,0,4,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatsText" Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
            <TextBlock x:Name="PendingText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="CopiedText" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </Grid>

        <!-- Details pane: metadata line · copy message · truncation note · full (pretty-printed) payload -->
        <Border Grid.Row="4" Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8,12,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailsMetaText" Grid.Column="0" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="MessageCopiedText" Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Button x:Name="CopyMessageButton" Grid.Column="2" CornerRadius="6" IsEnabled="False"
                            VerticalAlignment="Center" Click="OnCopyMessageClick" />
                </Grid>
                <TextBlock x:Name="TruncatedText" Grid.Row="1" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextSecondaryBrush}" Visibility="Collapsed" />
                <TextBox x:Name="PayloadBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" CornerRadius="6" IsSpellCheckEnabled="False"
                         VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
