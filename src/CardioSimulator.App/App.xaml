<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CardioSimulator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ════════════════════════════════════════════════════════════════
                 App design tokens (single source of truth). Theme dictionaries
                 provide per-theme palette tokens for Light and Dark modes.
                 Bind surfaces in XAML using {ThemeResource X}.
                 ════════════════════════════════════════════════════════════════ -->
            <!-- ════════════════════════════════════════════════════════════════
                 App design tokens (single source of truth). Theme dictionaries
                 provide per-theme palette tokens for Light and Dark modes.
                 Bind surfaces in XAML using {ThemeResource X}.
                 ════════════════════════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F2F2F7" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#D1D1D6" />
                    <SolidColorBrush x:Key="AppSubtleFillBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#F9F9FB" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="AppAccentSoftBackgroundBrush" Color="#EEF0FF" />
                    <SolidColorBrush x:Key="AppAccentSoftBorderBrush" Color="#C7CCF5" />
                    <SolidColorBrush x:Key="AppSuccessSoftBackgroundBrush" Color="#E5F9E7" />

                    <!-- Backward compatibility aliases for existing keys -->
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F2F7" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlFillBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D6" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#E5E5EA" />
                    <SolidColorBrush x:Key="HoverFillBrush" Color="#14808080" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#EEF0FF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#38383A" />
                    <SolidColorBrush x:Key="AppSubtleFillBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="AppAccentSoftBackgroundBrush" Color="#2A2A3D" />
                    <SolidColorBrush x:Key="AppAccentSoftBorderBrush" Color="#4A4A6A" />
                    <SolidColorBrush x:Key="AppSuccessSoftBackgroundBrush" Color="#14351A" />

                    <!-- Backward compatibility aliases for existing keys -->
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1C1C1E" />
                    <SolidColorBrush x:Key="ControlFillBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#38383A" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#2C2C2E" />
                    <SolidColorBrush x:Key="HoverFillBrush" Color="#28FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="#2A2A3D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Theme-invariant chrome (Header bar, bedside monitor, scenario overlay stay dark in both themes) -->
            <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#1C1C1E" />
            <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="#2C2C2E" />
            <SolidColorBrush x:Key="ChromeBorderBrush" Color="#38383A" />
            <SolidColorBrush x:Key="ChromeTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ChromeTextSecondaryBrush" Color="#8E8E93" />

            <!-- Brand/interactive accent (iOS system blue / green accent) -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#007AFF" />

            <!-- Theme-invariant brand colors & accents -->
            <Color x:Key="AccentColor">#FF33A06A</Color>
            <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
            <Color x:Key="PositiveColor">#FF2E9E5B</Color>
            <Color x:Key="NegativeColor">#FFCC3A3A</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />

            <!-- ── Make standard WinUI controls adopt the green accent ──────────
                 Override the framework accent color (and its light/dark ramp) plus
                 the derived accent fill brushes. -->
            <Color x:Key="SystemAccentColor">#FF33A06A</Color>
            <Color x:Key="SystemAccentColorLight1">#FF44B07A</Color>
            <Color x:Key="SystemAccentColorLight2">#FF5BBF8C</Color>
            <Color x:Key="SystemAccentColorLight3">#FF7FD0A6</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2C8E5E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF237A4F</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1A6640</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E633A06A" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC33A06A" />

            <!-- Softer, rounder default corners for standard controls -->
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
