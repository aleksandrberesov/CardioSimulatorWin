<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="$(var.BrandDisplayName)"
           Manufacturer="$(var.BrandManufacturer)"
           Version="1.0.1.0"
           UpgradeCode="7c2a7f51-8d2a-4a6c-974a-4e897e907a3c"
           Language="1033">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.BrandDisplayName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.BrandDisplayName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ShortcutComponents" Directory="INSTALLFOLDER">
      <Component Id="MainAppShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="$(var.BrandDisplayName)"
                  Description="$(var.BrandDisplayName)"
                  Directory="ApplicationProgramsFolder"
                  Target="[INSTALLFOLDER]$(var.BrandFileName).exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="$(var.BrandDisplayName)"
                  Directory="DesktopFolder"
                  Target="[INSTALLFOLDER]$(var.BrandFileName).exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <RemoveFolder Id="CleanupShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\VLNProject\$(var.BrandFileName)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Group-exam LAN server firewall exception.
         The Group-exam feature runs a tiny HTTP server (GroupTestServer binds 0.0.0.0:8080 with a
         free-port fallback) so students' phones on the same Wi-Fi can open the QR link. On a clean
         install there is no inbound rule, and Windows silently blocks inbound connections for
         standard (non-admin) users — no "Allow access?" prompt — so the phone's request never
         reaches the app and "the link won't open". The MSI runs elevated, so it can create the rule
         here. It is program-scoped (covers whichever port the server picks) and removed on uninstall. -->
    <ComponentGroup Id="FirewallComponents" Directory="INSTALLFOLDER">
      <Component Id="GroupExamFirewall" Guid="*">
        <fire:FirewallException Id="CardioGroupExamInbound"
                                Name="$(var.BrandDisplayName) - Group exam (LAN)"
                                Program="[INSTALLFOLDER]$(var.BrandFileName).exe"
                                Scope="any"
                                Profile="all"
                                Description="Allows students' phones on the local network to reach the $(var.BrandDisplayName) group-exam server."
                                IgnoreFailure="yes" />
        <RegistryValue Root="HKLM" Key="Software\VLNProject\$(var.BrandFileName)" Name="firewall" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="PublishedComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="FirewallComponents" />
    </Feature>
  </Package>
</Wix>
