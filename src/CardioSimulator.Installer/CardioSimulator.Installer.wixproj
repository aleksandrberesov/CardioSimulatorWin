<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>$(AppBrandFileName)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures Condition="'$(Cultures)' == ''">en-US;ru-RU;zh-CN;es-ES</Cultures>
    <SuppressIces>ICE03;ICE30;ICE61;ICE60</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="../../artifacts/publish">
      <ComponentGroupName>PublishedComponents</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressCom>true</SuppressCom>
      <PreprocessorVariable>var.PublishDir</PreprocessorVariable>
      <SuppressFileLanguage>true</SuppressFileLanguage>
    </HarvestDirectory>
  </ItemGroup>
  
  <PropertyGroup>
    <!-- Surface the build-time brand (Directory.Build.props) to Package.wxs as WiX preprocessor
         variables: $(var.BrandFileName) names the exe/registry, $(var.BrandDisplayName) is the
         user-facing product/folder/shortcut name, $(var.BrandManufacturer) the publisher. -->
    <DefineConstants>PublishDir=../../artifacts/publish;BrandFileName=$(AppBrandFileName);BrandDisplayName=$(AppBrandDisplayName);BrandManufacturer=$(AppBrandManufacturer)</DefineConstants>
  </PropertyGroup>
</Project>
